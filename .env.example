# Local development can use SQLite by leaving DATABASE_URL unset.
# Vercel/production MUST use a persistent PostgreSQL database (for example Neon).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Duitku Sandbox
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# Leave blank to auto-select the first active QRIS method: SP, NQ, or SQ.
DUITKU_PAYMENT_METHOD=
DUITKU_CALLBACK_URL=https://amba-shop-eta.vercel.app/callback
DUITKU_RETURN_URL=https://amba-shop-eta.vercel.app/payment.html
DUITKU_CUSTOMER_EMAIL=test@example.com

# Legacy Midtrans variables are no longer used by checkout.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SECRET=change-this-random-secret
ADMIN_PANEL_PATH=/management-7xK92
ADMIN_SESSION_MINUTES=30
